#!/usr/bin/env bash
# ==============================================================================
# Monorepo Pre-Commit Hook: Anti-AI Slop & Quality Gate
# Enforces AGENTS.md rules across Terraform, Python (uv), and Vanilla Frontend.
# ==============================================================================
set -euo pipefail

# Visual formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ------------------------------------------------------------------------------
# 0. Sanitize Environment (Local Isolation Defense)
# ------------------------------------------------------------------------------
if [ -n "${UV_PROJECT_ENVIRONMENT:-}" ]; then
    echo -e "${YELLOW}[WARN]${NC} External UV_PROJECT_ENVIRONMENT was set ($UV_PROJECT_ENVIRONMENT)."
    echo -e "       Unsetting to ensure strict local .venv isolation."
    unset UV_PROJECT_ENVIRONMENT
fi

# ------------------------------------------------------------------------------
# 1. Identify Staged Files
# ------------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FAILED=0

# ------------------------------------------------------------------------------
# 2. Check: Forbidden Files & Framework Creep (Boundary Enforcement)
# ------------------------------------------------------------------------------
for file in $STAGED_FILES; do
    filename=$(basename "$file")

    # Check for frontend bundler/framework creep (Vanilla Web Rule)
    case "$filename" in
        package.json|package-lock.json|yarn.lock|pnpm-lock.yaml|bun.lockb)
            echo -e "${RED}[BLOCKED - AI FRAMEWORK CREEP]${NC} Staged: ${BOLD}$file${NC}"
            echo -e "  -> Rule: Frontend must remain vanilla HTML/CSS/JS without Node.js or bundlers."
            FAILED=1
            ;;
    esac

    # Check for legacy Python package managers (uv rule)
    case "$filename" in
        requirements.txt|Pipfile|Pipfile.lock|setup.py|setup.cfg)
            echo -e "${RED}[BLOCKED - LEGACY PYTHON PACKAGING]${NC} Staged: ${BOLD}$file${NC}"
            echo -e "  -> Rule: Python packages must be managed exclusively via uv ('pyproject.toml' / 'uv.lock')."
            FAILED=1
            ;;
    esac

    # Check for committed secrets / local environments
    case "$filename" in
        .env|.env.local|.env.development|.env.production)
            echo -e "${RED}[BLOCKED - SECRET/ENV LEAK]${NC} Staged: ${BOLD}$file${NC}"
            echo -e "  -> Rule: Never commit environment files. Use .env.example instead."
            FAILED=1
            ;;
    esac

    # Check for Terraform state / secrets
    case "$filename" in
        *.tfstate|*.tfstate.*|crash.log)
            echo -e "${RED}[BLOCKED - TERRAFORM STATE LEAK]${NC} Staged: ${BOLD}$file${NC}"
            echo -e "  -> Rule: Terraform state and crash logs must never be committed."
            FAILED=1
            ;;
        *.tfvars)
            if [[ "$filename" != *".example."* && "$filename" != *".sample."* && "$filename" != *".template."* ]]; then
                echo -e "${RED}[BLOCKED - TERRAFORM VARS LEAK]${NC} Staged: ${BOLD}$file${NC}"
                echo -e "  -> Rule: Do not commit active .tfvars files. Commit .tfvars.example instead."
                FAILED=1
            fi
            ;;
    esac

    # Check for OS junk
    case "$filename" in
        .DS_Store|Thumbs.db)
            echo -e "${RED}[BLOCKED - SYSTEM JUNK]${NC} Staged: ${BOLD}$file${NC}"
            FAILED=1
            ;;
    esac
done

# ------------------------------------------------------------------------------
# 3. Check: AI Slop & Placeholder Detection in Staged Diffs
# ------------------------------------------------------------------------------
# Scans added lines (+) in code files for truncation, hallucinated placeholders, and lazy stubs
SLOP_PATTERN='(\.\.\. (existing|rest of|remaining|unchanged) code \.\.\.|<YOUR_[A-Z0-9_]+>|\[YOUR_[A-Z0-9_]+\]|YOUR_API_KEY_HERE|<REPLACE_ME>|REPLACE_WITH_YOUR_|pass[[:space:]]+#[[:space:]]*(todo|implement|replace)|raise[[:space:]]+NotImplementedError\([\"\x27]TODO)'

# Exclude hook configurations and documentation from the pattern search
CODE_DIFF=$(git diff --cached -U0 --no-prefix -- . \
    ':(exclude).githooks/*' \
    ':(exclude).pre-commit-config.yaml' \
    ':(exclude)*.md' 2>/dev/null || true)

DIFF_MATCHES=$(echo "$CODE_DIFF" | grep -E '^\+[^+]' | grep -E -i "$SLOP_PATTERN" || true)

if [ -n "$DIFF_MATCHES" ]; then
    echo -e "${RED}[BLOCKED - AI PLACEHOLDER / TRUNCATION SLOP]${NC} Found unfinished AI placeholders in staged code:"
    echo "$DIFF_MATCHES" | while IFS= read -r line; do
        echo -e "  ${YELLOW}${line}${NC}"
    done
    echo -e "  -> Fix: Remove placeholder comments, truncation markers, or mock stubs before committing."
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 4. Check: Git Conflict Markers & Whitespace Errors
# ------------------------------------------------------------------------------
if ! git diff --cached --check > /dev/null 2>&1; then
    echo -e "${RED}[BLOCKED - GIT WHITESPACE / CONFLICT]${NC}"
    git diff --cached --check
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 5. Check: Terraform Formatting (if .tf files staged)
# ------------------------------------------------------------------------------
TF_STAGED=$(echo "$STAGED_FILES" | grep -E '\.tf$' || true)
if [ -n "$TF_STAGED" ]; then
    echo -e "${BLUE}[CHECK]${NC} Validating Terraform formatting..."
    for tf_file in $TF_STAGED; do
        if [ -f "$tf_file" ]; then
            if ! terraform fmt -check "$tf_file" > /dev/null 2>&1; then
                echo -e "${RED}[FAIL]${NC} Terraform file unformatted: ${BOLD}$tf_file${NC}"
                echo -e "  -> Fix: Run 'terraform fmt $tf_file'"
                FAILED=1
            fi
        fi
    done
fi

# ------------------------------------------------------------------------------
# 6. Check: Python Quality (Ruff, Basedpyright, Vulture)
# ------------------------------------------------------------------------------
PY_STAGED=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
if [ -n "$PY_STAGED" ]; then
    echo -e "${BLUE}[CHECK]${NC} Checking Python syntax and formatting with Ruff..."

    RUFF_CMD=""
    if command -v ruff > /dev/null 2>&1; then
        RUFF_CMD="ruff"
    elif command -v uv > /dev/null 2>&1; then
        RUFF_CMD="uvx ruff"
    fi

    if [ -n "$RUFF_CMD" ]; then
        for py_file in $PY_STAGED; do
            if [ -f "$py_file" ]; then
                if ! $RUFF_CMD format --check "$py_file" > /dev/null 2>&1; then
                    echo -e "${RED}[FAIL]${NC} Python format check failed: ${BOLD}$py_file${NC}"
                    echo -e "  -> Fix: Run '${RUFF_CMD} format $py_file'"
                    FAILED=1
                fi
                if ! $RUFF_CMD check "$py_file" > /dev/null 2>&1; then
                    echo -e "${RED}[FAIL]${NC} Python lint check failed: ${BOLD}$py_file${NC}"
                    echo -e "  -> Fix: Run '${RUFF_CMD} check --fix $py_file'"
                    FAILED=1
                fi
            fi
        done
    fi

    # Type checking via Basedpyright
    echo -e "${BLUE}[CHECK]${NC} Verifying types with Basedpyright..."
    PYRIGHT_CMD=""
    if command -v basedpyright > /dev/null 2>&1; then
        PYRIGHT_CMD="basedpyright"
    elif command -v uv > /dev/null 2>&1; then
        PYRIGHT_CMD="uvx basedpyright"
    fi

    if [ -n "$PYRIGHT_CMD" ]; then
        if ! $PYRIGHT_CMD $PY_STAGED > /dev/null 2>&1; then
            echo -e "${RED}[FAIL]${NC} Basedpyright type check failed on staged Python files."
            echo -e "  -> Fix: Run '${PYRIGHT_CMD} ${PY_STAGED}' to inspect type errors."
            FAILED=1
        fi
    fi

    # Dead code scanning via Vulture
    echo -e "${BLUE}[CHECK]${NC} Scanning for dead code with Vulture..."
    VULTURE_CMD=""
    if command -v vulture > /dev/null 2>&1; then
        VULTURE_CMD="vulture"
    elif command -v uv > /dev/null 2>&1; then
        VULTURE_CMD="uvx vulture"
    fi

    if [ -n "$VULTURE_CMD" ]; then
        if ! $VULTURE_CMD $PY_STAGED --min-confidence 80 > /dev/null 2>&1; then
            echo -e "${RED}[FAIL]${NC} Vulture detected unused or dead code in staged files."
            echo -e "  -> Fix: Run '${VULTURE_CMD} ${PY_STAGED} --min-confidence 80' to inspect."
            FAILED=1
        fi
    fi
fi

# ------------------------------------------------------------------------------
# Final Status
# ------------------------------------------------------------------------------
if [ "$FAILED" -ne 0 ]; then
    echo -e "\n${RED}${BOLD}Pre-commit checks failed.${NC} Please address the issues above and re-stage your changes."
    exit 1
fi

echo -e "${GREEN}✓ All pre-commit quality and anti-slop checks passed.${NC}"
exit 0
